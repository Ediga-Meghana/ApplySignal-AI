{
  "name": "applysignal-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "bash supabase/tests/run.sh",
    "test:e2e": "node scripts/live-e2e.mjs",
    "test:functions": "deno run --import-map=supabase/tests/functions/import_map.json --allow-env --allow-read --no-check supabase/tests/functions/ai_test.ts && deno run --import-map=supabase/tests/functions/import_map.json --allow-env --allow-read --no-check supabase/tests/functions/reminders_test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "deno": "^2.9.6",
    "jsdom": "^30.1.2",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  }
}
